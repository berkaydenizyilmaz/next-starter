# pnpm start'ın portu. Yayında platform verir; Nest 3000'de çalıştığı için
# yerelde 3001.
PORT=3001

# Nest API'sinin kök adresi
API_URL=http://localhost:3000

# Next'in önünde X-Forwarded-For'a ekleme yapan proxy sayısı. İstemci IP'si
# bu başlığın sağdan bu sıradaki değeridir. Yayında Next bu başlığı yazan bir
# proxy'nin arkasında olmalı; doğrudan açıksa istemci sahte IP gönderebilir.
# Geliştirmede proxy yokken de 1 doğrudur: başlığı Next kendisi doldurur.
TRUST_PROXY_HOPS=1

# error · warn · info · debug
LOG_LEVEL=debug

# Oturum cookie'sini şifreleyen anahtar, en az 32 karakter. Üretmek için:
# openssl rand -base64 32
SESSION_SECRET=

# Nest'teki STORAGE_PUBLIC_URL, yani public dosyaların alan adı. Avatar gibi
# görseller buradan yüklenir; CSP'nin img-src'sine girer.
STORAGE_PUBLIC_ORIGIN=

# Tarayıcının dosyayı PUT ettiği adresin kökeni; CSP'nin connect-src'sine girer.
# Nest'in /files/uploads cevabındaki uploadUrl'in kökenidir. R2'de bucket adı
# host'ta durur: https://<private-bucket>.<account_id>.r2.cloudflarestorage.com
STORAGE_UPLOAD_ORIGIN=
